HOST=0.0.0.0
REQUIRE_API_TOKEN=0
CORS_ALLOW_ORIGIN=*

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=dataservice_test_local

# LLM for scene/configuration flow
LLM_AGENT_PROVIDER=modelscope
LLM_AGENT_HTTP_ENDPOINT=http://your-llm-host/v1/chat/completions
LLM_AGENT_HTTP_MODEL=your-model
LLM_AGENT_API_KEY=your-api-key

# LLM for SQL result agent
SQL_RESULT_AGENT_PROVIDER=modelscope
SQL_RESULT_AGENT_HTTP_ENDPOINT=http://your-llm-host/v1/chat/completions
SQL_RESULT_AGENT_HTTP_MODEL=your-model
SQL_RESULT_AGENT_API_KEY=your-api-key

# 模型切换（前端 index.html 的「模型」下拉；对全部页面/全部链路生效）
# 两档：gpt-5.2 = 上面那套内网网关；deepseek = DeepSeek 官方 API。
# 不填 DEEPSEEK_API_KEY 时该档在接口里 available=false，切过去会被如实拒绝（不会静默退回）。
DEEPSEEK_API_KEY=your-deepseek-api-key
# 可选覆盖项（都有默认值，通常不用改）：
# DEEPSEEK_HTTP_ENDPOINT=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_HTTP_MODEL=deepseek-flash
# DEEPSEEK_HTTP_TIMEOUT=90
# DEEPSEEK_AGENT_MODEL=fz-deepseek

# PPT exporter
