HOST=0.0.0.0
REQUIRE_API_TOKEN=0
CORS_ALLOW_ORIGIN=*

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=dataservice_test_local

# Configuration-center LLM runtime.
# The backend expects an OpenAI-compatible Chat Completions endpoint.
LLM_AGENT_PROVIDER=modelscope
LLM_AGENT_HTTP_ENDPOINT=http://your-llm-host/v1/chat/completions
LLM_AGENT_HTTP_MODEL=gpt-5.2
LLM_AGENT_API_KEY=your-api-key
LLM_AGENT_HTTP_TIMEOUT=90

# SQL generation LLM runtime.
# provider can be http or modelscope for OpenAI-compatible Chat Completions.
SQL_RESULT_AGENT_PROVIDER=modelscope
SQL_RESULT_AGENT_HTTP_ENDPOINT=http://your-llm-host/v1/chat/completions
SQL_RESULT_AGENT_HTTP_MODEL=gpt-5.2
SQL_RESULT_AGENT_API_KEY=your-api-key
SQL_RESULT_AGENT_HTTP_TIMEOUT=90

# PPT exporter
VIBE_PPTX_EXPORTER=python-pptx
